# MCP Server Configuration
# Default MCP server URL (can be overridden with -s flag)
MCP_SERVER_URL=http://10.254.254.254:8080/

# Optional: Request timeout in milliseconds
MCP_TIMEOUT=30000

# Optional: Custom headers for MCP requests (JSON format)
# MCP_HEADERS={"Authorization":"Bearer your-token"}

# Optional: Default files to include (comma-separated)
# DEFAULT_FILES=README.md,package.json